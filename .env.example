# Copy to .env before bringing the stack up. Everything above the first blank
# section is required; the stack refuses to start without it.

# ── required ──────────────────────────────────────────────────────────────────

# Signs the access tokens. Any long random string; `openssl rand -hex 32` does.
# Changing it invalidates every token in circulation, which signs everyone out
# until their browser refreshes.
SESSION_SECRET=

# The database's password. The gateway keeps accounts, invites, refresh tokens,
# and outstanding sign-in codes there.
POSTGRES_PASSWORD=

# Mailing a sign-in code is the whole of authentication here, so a deployment
# without a credential refuses to start. https://resend.com
RESEND_API_KEY=

# Which model the tenants' agents call, and with what.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ── the operator's console ────────────────────────────────────────────────────

# A separate service, on a separate hostname, with a credential that belongs to
# the deployment rather than to any account. Publish it somewhere tenants cannot
# reach: one password here opens every account and the model credential.

# The hostname nginx answers for it on. Empty and no console vhost is written,
# which is the right default — the service still listens on loopback.
# ADMIN_DOMAIN=admin.example.com

# ADMIN_USERNAME=admin

# Produced by `node admin/hash-password.mjs`, which reads the password from
# stdin so it never reaches a shell history. Without it the service refuses to
# start rather than starting with a default, which is a published password.
#
# The hash contains `$`. Compose reads that as a variable, so write each one
# twice: scrypt$$<salt>$$<hash>.
ADMIN_PASSWORD_HASH=

# Its own, not the gateway's. Sharing one would mean a token minted for a tenant
# and a token minted for an operator were signed by the same key.
ADMIN_SESSION_SECRET=

# What lets the console ask the gateway to release a machine or delete an
# account. Both sides must agree; empty on either side and the channel is
# refused, so an operator's delete would report that nothing happened.
INTERNAL_SHARED_SECRET=

# The second factor is not here. It is enrolled from the console itself — sign
# in, press the button, scan the square — because a secret that can only be
# written to a file cannot be the place a phone is enrolled.

# ── who gets in ───────────────────────────────────────────────────────────────

# Addresses this deployment names, comma-separated. They skip the invite
# requirement, so the first tenant of a fresh deployment can sign in before any
# invite exists, and they stand in for POLICY_CONTACT when that is unset.
#
# They do NOT reach the operator's console. That is a separate service with its
# own credential — see below.
GATEWAY_ADMINS=

# What bounds the mail this deployment can be made to send. The sign-in form
# takes any address, so without these it is a way to send mail from this domain
# to anyone. Per caller counts requests; the second is the deployment's own
# ceiling on messages that actually leave, and it fails closed.
# LOGIN_REQUESTS_PER_IP_PER_HOUR=20
# LOGIN_SENDS_PER_HOUR=200

# `invite` (default) requires an unused code to register; `open` lets anyone
# who can receive mail in, which is what a deployment on a reachable address
# should not be. Where the administrator's console has set this, the console
# wins: this is the value a deployment starts from, not the one it keeps.
REGISTRATION=invite

# The most sandboxes that may run at once, which is the host's memory written
# down: 0, the default, is no ceiling. A sign-in that would exceed it is
# refused — after the mailed code, so a full deployment is not also a way to
# ask who has an account — while whoever already holds a machine still gets in.
# Also a switch in the console, which wins over this.
# SANDBOX_LIMIT=0

# Where a tenant reaches whoever runs this deployment: shown on the terms, the
# data notice and the safe-use policy, which grant rights that need somewhere to
# be exercised. Defaults to the first address in GATEWAY_ADMINS; set this to
# publish a role address instead of a person's.
# POLICY_CONTACT=support@example.com

# Must be at a domain verified with Resend. Its shared sender works without
# verification but only delivers to the Resend account's owner, which is enough
# to try the flow and not enough to run it.
EMAIL_FROM=onboarding@resend.dev
EMAIL_PRODUCT_NAME=DSH

# How long a browser stays signed in without presenting a code again.
REFRESH_TTL_SECONDS=2592000

# ── where it listens ──────────────────────────────────────────────────────────

# The plain and TLS ports the front door publishes. Browsers must use the TLS
# one: the client plugins call `crypto.randomUUID`, which a page served over
# plain HTTP to anything but localhost does not have.
GATEWAY_PORT=8080
GATEWAY_TLS_PORT=8443

# Interface to publish the TLS port on. Set it when something else already
# holds that port on another interface.
# TLS_BIND=0.0.0.0

# Every address this deployment is reached by. A browser rejects outright — with
# no warning to click through — a certificate that does not name the address in
# the URL bar. Only the self-signed certificate reads this; a real one names
# whatever it was issued for.
TLS_SAN=DNS:localhost,IP:127.0.0.1

# The HTTPS port visitors actually type. Set it and the plain port stops serving
# the site and redirects there instead; leave it unset and the plain port keeps
# serving, which is what a localhost deployment wants. It has to be named here
# because nginx sees the 443 it listens on inside the container and not the port
# the container publishes, so it cannot work the address out for itself. This is
# usually the same value as GATEWAY_TLS_PORT, and differs when something in
# front — a load balancer, a router — publishes it on another port.
# PUBLIC_HTTPS_PORT=8443

# ── sandboxes ─────────────────────────────────────────────────────────────────

# `docker` is the simulation a laptop can run; `cube` is CubeSandbox, where each
# tenant gets a microVM. See "Running on CubeSandbox" in README.md.
SANDBOX_RUNTIME=docker

# Quiet time before a tenant's sandbox is reclaimed. Measured on tunnel traffic,
# so a long agent turn holds its sandbox for as long as it keeps streaming.
# Their files survive reclamation when volumes are on.
SANDBOX_IDLE_TTL_MS=1800000

# And once nobody is looking at it. A browser holds the /api event socket for as
# long as its page is loaded, so no socket is the tenant having closed the tab.
# Neither applies while an agent is working: a turn with no browser attached
# sends nothing through the tunnel, and is spared on what the sandbox reports
# about itself rather than on traffic.
# SANDBOX_DEPARTED_TTL_MS=300000

# ── Where the build fetches from ──────────────────────────────────────────────
#
# All three empty use the public source. A host far from any of them waits out
# an apt download, ~200 npm packages, and the sandbox's Python stack on every
# uncached build, so name a mirror close to it. Base images are the Docker
# daemon's `registry-mirrors`, not these.
#
# `PIP_INDEX_URL` also stays in the sandbox image as /etc/pip.conf, so a
# tenant's own `pip install` reaches the same mirror the build did.

# Name one this host can actually reach, not one that is merely nearby: a
# university mirror answered 403 to this deployment's machine while the cloud
# mirror beside it answered in 0.1s, and pip reports that as "no matching
# distribution" rather than as a refusal.

# APT_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# What the agent can reach for in Python. Unset, the sandbox image installs the
# deployment's list — pandas, matplotlib, pdfplumber and the rest — which is the
# only answer a tenant should ever meet, and by a wide margin the slowest step
# in the build.
#
# Set it empty for a build that is not for tenants: one being exercised for its
# gateway, its frontend, or a page, where nothing asks the agent to read a
# spreadsheet. The environment is still created and still on PATH; there is
# nothing in it, and `scripts/check-images.sh` will say so.
# AGENT_PYTHON_PACKAGES=

# The deployment's clock: what a tenant's sandbox dates its files by, and what
# the console renders its timestamps in. Containers default to UTC, which puts
# every one of those an hour count away from whoever is reading it.
# DEPLOYMENT_TZ=Asia/Shanghai

# ── CubeSandbox only (compose.cube.yml) ───────────────────────────────────────

# CUBE_API_URL=http://host.docker.internal:3000
# CUBE_API_KEY=e2b_000000
# CUBE_TEMPLATE_ID=hamsterhq-sandbox
# Starting a tenant's backend is a call *into* their sandbox, which CubeProxy
# routes on a hostname that is not in DNS for a local installation.
# CUBE_PROXY_NODE_IP=
# CUBE_PROXY_PORT_HTTP=30080
# Sandboxes dial this to reach the gateway; it must name a host address, since
# a sandbox is a machine on Cube's own network.
# GATEWAY_TUNNEL_URL=ws://10.100.0.1:8090/_tunnel
# TUNNEL_PORT=8090
# One volume per tenant, attached by deploy/volume-plugin. `off` makes
# sandboxes ephemeral.
# SANDBOX_VOLUMES=on
# SANDBOX_VOLUME_DRIVER=juicefs
# SANDBOX_VOLUME_MOUNT=/persist

# ── a real certificate (compose.tls.yml) ──────────────────────────────────────

# DNSPod API credentials, used to answer the DNS-01 challenge. The only
# challenge available to a deployment that cannot use ports 80 and 443.
# DP_ID=
# DP_KEY=

# ── optional ──────────────────────────────────────────────────────────────────

# Which DSH release the images install, and therefore the one the login page
# names. A build argument rather than a runtime setting: it decides what is in
# the image, and a value that could be changed after the build could only ever
# make the footer disagree with what a tenant is running. Left unset, the pin at
# the top of the Dockerfile stands. Changing it needs a rebuild.
# DSH_VERSION=

# A Debian mirror for image builds, for networks where deb.debian.org stalls.
# APT_MIRROR=mirrors.aliyun.com

# POSTGRES_USER=dsh
# POSTGRES_DB=dsh
# POSTGRES_IMAGE=postgres:16-alpine
